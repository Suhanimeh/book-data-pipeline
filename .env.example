# Copy to .env to override the defaults used by docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=books

# Scraper settings
SCRAPE_MAX_PAGES=5      # 20 books per page (the site has 50 pages / 1000 books)
REQUEST_DELAY=0.3       # seconds between requests
AUTO_SEED=true          # scrape automatically on first start when the DB is empty
CORS_ORIGINS=*
